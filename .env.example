# ============================================================
# PULSE — Org Heartbeat (P · U · L · S · E)
# Copy to .env and fill in your values:  cp .env.example .env
# ============================================================

# Required — LLM API (all calls go through OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Required — Database
DB_USER=pulse
DB_PASS=change-this-password
DB_DATABASE=pulsedb
# DB_HOST=db  (auto-set by Docker Compose)

# Server port (default: 8090)
PORT=8090

# Optional — Override models
# ROUTER_MODEL=google/gemini-3.1-flash-lite-preview
# VISION_MODEL=google/gemini-3-flash-preview
# FALLBACK_MODEL=google/gemini-2.0-flash-001
# EMBEDDING_MODEL=google/gemini-embedding-2-preview
# LOG_LEVEL=INFO

# Optional — LLM safety
# LLM_CALL_TIMEOUT_S=60       # Per-call hard timeout in seconds
# LLM_DAILY_CAP_USD=50        # Per-tenant daily LLM spend cap (USD)

# Optional — Matching behavior
# When true, every newly uploaded CV is auto-matched against ALL active
# positions (Step 12 of the CV pipeline). When false (default), CV→position
# matching ONLY happens at position-create/update time. Leave OFF for bulk
# CV ingestion to avoid scanning every position per upload.
MATCH_ON_CV_UPLOAD=false

# Security — Admin login (leave empty for dev mode = no login)
ADMIN_USER=admin
ADMIN_PASS=change-me

# Security — CORS origins (comma-separated; no wildcard in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8090

# Security — HMAC secret for signed /candidates/{id}/file URLs (5 min TTL).
# Falls back to JWT_SECRET if unset; otherwise an ephemeral secret is generated
# at startup (signed URLs will not survive process restart).
# FILE_SIGN_SECRET=replace-with-32-byte-random-hex
JWT_SECRET=replace-with-32-byte-random-hex
JWT_EXPIRY_H=8

# --- Auth / Superadmin bootstrap ---
# Generate hash with: python -m backend.scripts.hash_pw <password>
SUPERADMIN_ID=admin
SUPERADMIN_PASS_HASH=
# SUPERADMIN_PASS=dev-only-plaintext   # dev only — hashed at startup, log warning
ALLOW_REGISTER=false
LOGIN_LOCKOUT_AFTER=5
LOGIN_LOCKOUT_MIN=15

# ── Storage backend ──
STORAGE_BACKEND=local       # local | s3
# S3_BUCKET=pulse-cvs-prod
# S3_REGION=us-east-1

# ── ECS / production ──
LOG_FORMAT=text             # use 'json' in ECS task definition
RUN_MIGRATIONS_ON_BOOT=true # advisory lock makes this safe with multiple ECS tasks
APP_VERSION=1.0.0           # surfaces on /api/health

# ── DB pool tuning ──
# DB_POOL_MIN=2             # min idle connections per task
# DB_POOL_MAX=10            # max connections per task (×N tasks ≤ RDS max_connections)

# ── AWS Parameter Store hydration (optional) ──
# LOAD_SSM=1                # fetch /pulse/prod/* into env on startup
# SSM_PREFIX=/pulse/prod/
# AWS_REGION=us-east-1

# Agno agent (chat v2) — flag-gated, default off
AGENT_V2=false
AGNO_MODEL=google/gemini-3-flash-preview
AGNO_MAX_STEPS=8
AGNO_TOOL_TIMEOUT_S=15
AGNO_MEMORY_TOPK=5
AGNO_ENABLE_REFLECTION=false
AGENT_SESSION_CAP_USD=1
REDIS_URL=redis://redis:6379/0

# Optional — Email notifications (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourcompany.com
