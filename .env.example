# ============================================================================
# PULSE — Org Heartbeat
# ============================================================================
# Quick start (manual flow):
#   1) cp .env.example .env
#   2) Edit the 4 values in the REQUIRED section below.
#   3) docker compose up -d --build
#   4) Wait ~60s, open  http://<host>:${PORT}  and log in.
#
# Everything outside the REQUIRED section is optional — sensible defaults are
# auto-applied by the app + compose.yaml. Leave commented unless you need it.
# ============================================================================


# ============================================================================
# REQUIRED — edit these 4 values
# ============================================================================

# 1) OpenRouter API key. Get one at https://openrouter.ai/keys
#    Leave blank to skip AI features (app still boots, CV upload works, AI off).
OPENROUTER_API_KEY=

# 2) Superadmin login (you'll use this to log in the first time).
SUPERADMIN_ID=pulse_admin
SUPERADMIN_PASS=admin

# 3) HTTP port — your browser opens http://<host>:<PORT>
PORT=8090


# ============================================================================
# OPTIONAL — uncomment only if you need to override defaults
# ============================================================================
# Database (auto-generated random password if left at default; safe for dev).
# For production, set a strong DB_PASS BEFORE first boot — Postgres ignores
# password changes on an existing data volume.
# DB_USER=pulse
# DB_PASS=change-me-strong
# DB_DATABASE=pulsedb

# JWT secret. If blank, app auto-generates one and persists it to
# /data/.jwt_secret inside the container (survives restart). Set explicitly
# if you run multiple API instances behind a load balancer.
# JWT_SECRET=
# JWT_EXPIRY_H=8

# Stronger superadmin: bcrypt hash takes precedence over plaintext SUPERADMIN_PASS.
# Generate:  docker run --rm python:3.11-slim sh -c "pip -q install bcrypt && \
#   python -c \"import bcrypt; print(bcrypt.hashpw(b'YourPass', bcrypt.gensalt(12)).decode())\""
# SUPERADMIN_PASS_HASH=

# Allowed CORS origins. Default regex (^https?://[^/]+$) allows any host, which
# is safe because auth uses Bearer tokens (not cookies). Tighten in prod if you
# need a strict allowlist.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8090
# ALLOWED_ORIGIN_REGEX=^https?://[^/]+$

# Runtime tuning (defaults are safe for ~10 concurrent users on a 4-core box).
# WORKERS=1                  # uvicorn workers. Keep at 1 unless you migrate
#                            # _pipeline_queue + _active_tasks to Redis first.
# OCR_CONCURRENCY=1          # PaddleOCR parallel jobs (~500MB RAM each).
# LLM_MAX_CONCURRENT=8       # OpenRouter calls per worker.
# RATE_LIMIT=600/minute      # global default; per-route caps still apply.
# DEV_MODE=false             # NEVER set true in prod — bypasses auth entirely.

# LLM safety
# LLM_CALL_TIMEOUT_S=60
# LLM_DAILY_CAP_USD=200      # per-tenant daily LLM spend cap.

# Model overrides (defaults set in backend/core/config.py)
# CHAT_MODEL=google/gemini-3-flash-preview
# LITE_MODEL=google/gemini-3.1-flash-lite-preview
# DEEP_MODEL=openai/gpt-5.4-mini
# VISION_VERIFIER_MODEL=anthropic/claude-opus-4-20250514
# EMBED_MODEL=openai/text-embedding-3-small
# SUMMARY_MODEL=google/gemini-3.1-flash-lite-preview

# Matching behavior
# MATCH_ON_CV_UPLOAD=false   # auto-match new CVs against all positions

# Storage (S3 — leave empty for local disk)
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Redis (compose.yaml default points to the bundled redis service)
# REDIS_URL=redis://redis:6379/0

# File-signing HMAC (falls back to JWT_SECRET if unset)
# FILE_SIGN_SECRET=

# Logging
# LOG_FORMAT=text   # or "json" for structured logs
# LOG_LEVEL=INFO
